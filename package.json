{
  "name": "jobber-api-gatweay",
  "version": "1.0.0",
  "description": "API gateway",
  "main": "app.js",
  "scripts": {
    "start": "pm2 start ./build/app.js -i 5 --attach --watch | pino-pretty -c",
    "stop": "pm2 stop all",
    "delete": "pm2 delete all",
    "clean": "rimraf ./build",
    "build": "npm run clean && tsc",
    "compile:watch": "tsc --watch",
    "run:js": "node --watch ./build/app.js",
    "dev": "concurrently -n \"TypeScript,Node\" -c \"cyan,green\" \"npm run compile:watch\" \"npm run run:js\"",
    "test": "cross-env NODE_OPTIONS=\"--experimental-vm-modules\" jest --coverage=true -w=1 --forceExit --detectOpenHandles --watchAll=false"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@dharanigk2002/jobber-shared": "^1.0.11",
    "@elastic/elasticsearch": "^9.5.1",
    "axios": "^1.21.0",
    "bcrypt": "^6.0.0",
    "compression": "^1.8.2",
    "cookie-session": "^2.1.1",
    "cors": "^2.8.6",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "hpp": "^0.2.3",
    "http-status-codes": "^2.3.0",
    "jsonwebtoken": "^9.0.3",
    "rimraf": "^6.1.3",
    "typescript-transform-paths": "^4.0.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@jest/types": "^30.5.1",
    "@types/compression": "^1.8.1",
    "@types/cookie-session": "^2.0.49",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/hpp": "^0.2.7",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.5",
    "concurrently": "^10.0.6",
    "ts-patch": "^4.0.1"
  }
}
